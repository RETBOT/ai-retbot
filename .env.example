# ============================================
# RETBOT - Ejemplo de Archivo .env
# ============================================
# Copiar este archivo como .env y ajustar valores
# ============================================

# ============================================
# CONFIGURACIÓN OBLIGATORIA
# ============================================

# Password del usuario admin (se crea automáticamente al iniciar)
ADMIN_PASSWORD=***REDACTED***

# Clave secreta para JWT (cambiar en producción)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=tu_clave_secreta_larga_y_aleatoria_minimo_32_caracteres

# API Key - cambiar en producción
API_KEY=demo_key_123

# ============================================
# CONFIGURACIÓN DE MODELO
# ============================================

# Modelo a usar - Qwen2.5 Coder recomendado para programación
# Sin GPU (CPU): qwen2.5-coder:3b o qwen2.5-coder:7b
# 1 GPU 4090: qwen2.5-coder:14b o qwen2.5-coder:32b
# 2-3 GPUs: qwen2.5-coder:32b
MODEL_NAME=qwen2.5-coder:3b

# Tipo de modelo (ollama, openai, etc.)
MODEL_TYPE=ollama

# URL de Ollama
OLLAMA_URL=http://localhost:11434

# ============================================
# CONFIGURACIÓN DE CONCURRENCIA (GPU)
# ============================================

# OLLAMA_NUM_PARALLEL - Número de requests simultáneas
# Sin GPU: COMENTAR (usar default, 1 request a la vez)
# 1 GPU 4090 + 14b: 4
# 1 GPU 4090 + 32b: 2
# 2 GPUs 4090 + 14b: 8
# 2 GPUs 4090 + 32b: 4
# 3 GPUs 4090 + 32b: 6-8
# OLLAMA_NUM_PARALLEL=4

# Máximo de modelos cargados en VRAM al mismo tiempo
# 1 GPU: 1-2
# 2-3 GPUs: 2-3
# OLLAMA_MAX_LOADED_MODELS=2

# ============================================
# CONFIGURACIÓN DE CONTEXTO
# ============================================

# Longitud del contexto (tokens)
# Sin GPU: 4096 (más rápido en CPU)
# Con GPU: 8192 o más
OLLAMA_CONTEXT_LENGTH=4096

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================

# Puerto del servidor (default: 8000)
PORT=8000

# Rate limiting - requests por minuto por usuario (default: 10)
RATE_LIMIT_PER_MINUTE=10

# ============================================
# CORS - Orígenes permitidos
# ============================================

# Para desarrollo local, localhost está permitido por defecto
# En producción, agregar tu dominio
# ALLOWED_ORIGINS=https://tu-dominio.com
# Para permitir todos: ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ============================================
# REDIS (opcional, para colas y cache)
# ============================================

# REDIS_URL=redis://localhost:6379

# ============================================
# CONFIGURACIÓN PARA MÚLTIPLES GPUs
# ============================================

# Cuando tengas 2-3 GPUs, descomentar y ajustar:
# CUDA_VISIBLE_DEVICES=0,1,2

# URL de OpenCode (si usas integración)
OPENCODE_URL=http://localhost:54321

# ============================================
# GUÍA RÁPIDA DE CONFIGURACIÓN
# ============================================
#
# Sin GPU (CPU):
#   MODEL_NAME=qwen2.5-coder:3b
#   # OLLAMA_NUM_PARALLEL=   (comentar)
#   OLLAMA_CONTEXT_LENGTH=4096
#
# 1 GPU RTX 4090:
#   MODEL_NAME=qwen2.5-coder:14b
#   OLLAMA_NUM_PARALLEL=4
#   OLLAMA_CONTEXT_LENGTH=8192
#
# 2 GPUs RTX 4090:
#   MODEL_NAME=qwen2.5-coder:32b
#   OLLAMA_NUM_PARALLEL=8
#   CUDA_VISIBLE_DEVICES=0,1
#
# 3 GPUs RTX 4090:
#   MODEL_NAME=qwen2.5-coder:32b
#   OLLAMA_NUM_PARALLEL=12
#   CUDA_VISIBLE_DEVICES=0,1,2
#
# ============================================
